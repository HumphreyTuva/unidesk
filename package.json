{
  "name": "unidesk",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm -w api run start:dev",
    "dev:web": "npm -w web run dev",
    "db:up": "docker compose up -d",
    "db:push": "npm -w api run db:push",
    "db:migrate": "npm -w api run db:migrate",
    "db:seed": "npm -w api run db:seed",
    "sync:content": "node scripts/sync-content.mjs"
  }
}
