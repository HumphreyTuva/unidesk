# Local development (docker compose up -d). On Neon: DATABASE_URL = pooled string, DIRECT_URL = direct string.
DATABASE_URL="postgresql://unidesk:unidesk@localhost:5433/unidesk"
DIRECT_URL="postgresql://unidesk:unidesk@localhost:5433/unidesk"

# Long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me"

PORT=4000
# The website's address(es), comma separated. The website talks to this API through its own /api proxy.
WEB_ORIGIN="http://localhost:3000"

# Google sign-in: the OAuth Client ID from Google Cloud (not secret). Leave empty to switch Google sign-in off.
GOOGLE_CLIENT_ID=

# Admin accounts. These emails become ADMIN only when signed in through Google (verified by Google).
# Password sign-up with these emails is blocked, so nobody can claim an admin email first.
ADMIN_EMAILS=""

# Used only by `npm run db:seed` to create the first admin who signs in with a password (optional).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Paper files. local = saved in apps/api/uploads (testing on your computer only; Render's disk is wiped on every deploy).
# For hosting use Cloudflare R2 (or any S3-compatible bucket). Keep the bucket PRIVATE: files are only served through the API.
STORAGE_DRIVER=local
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=unidesk
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# M-Pesa (Daraja). Credentials go here or in Render's environment settings, never in chat or git.
# mock = a fake prompt that approves itself after a few seconds, for testing on your computer. It is refused when NODE_ENV=production.
MPESA_MODE=mock
# For real payments set MPESA_MODE=live and fill in ALL of these:
# MPESA_BASE_URL=https://sandbox.safaricom.co.ke      (production: https://api.safaricom.co.ke)
# MPESA_KEY=               Consumer Key from the Daraja app
# MPESA_SECRET=            Consumer Secret
# MPESA_SHORTCODE=         the till's store / head-office number (sandbox: shown in the Daraja simulator)
# MPESA_PASSKEY=           Lipa na M-Pesa Online passkey
# MPESA_PARTY_B=           the Till number customers pay to (Buy Goods). Leave empty for a Paybill.
# MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline        (Paybill: CustomerPayBillOnline)
# MPESA_CALLBACK_SECRET=   a long random string
# MPESA_CALLBACK_URL=https://YOUR-API.onrender.com/api/v1/payments/mpesa/callback?secret=<the same long random string>

# AI assistant (optional). Use ONE of these keys. On Render, set them in Environment, never in git.
# Gemini (free tier available): key from aistudio.google.com.   Claude: key from console.anthropic.com.
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
# AI_PROVIDER=gemini            # only needed if both keys are set
# AI_MODEL=gemini-3.8-flash     # default for Gemini. For Claude the default is claude-haiku-5-5
# AI_DAILY_LIMIT=30             # questions per student per day
# AI_THINKING_LEVEL=low         # optional: faster answers from newer Gemini models (low or minimal)
